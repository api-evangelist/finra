{
  "opencollection": "1.0.0",
  "info": {
    "name": "FINRA Query Async Metadata API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Metadata",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve dataset field definitions and metadata",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.finra.org/metadata/group/:group/name/:dataset",
            "params": [
              {
                "name": "group",
                "value": "",
                "type": "path"
              },
              {
                "name": "dataset",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve dataset field definitions and metadata"
        }
      ]
    }
  ],
  "bundled": true
}